{
  "version": 2,
  "builds": [
    {
      "src": "northstar-ai/ai_server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": "northstar-ai/ai_server.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
