# ==============================
# NorthStar AI
# ==============================

# Local Python environment / caches
northstar-ai/.venv/
northstar-ai/**/__pycache__/
northstar-ai/**/*.pyc

# Downloaded model files
northstar-ai/models/

# Training datasets / evaluations
northstar-ai/data/

# Training checkpoints - ignore all by default
northstar-ai/adapters/*

# Keep only production V5 checkpoint
!northstar-ai/adapters/northstar-v5-2900/
!northstar-ai/adapters/northstar-v5-2900/adapter_config.json
!northstar-ai/adapters/northstar-v5-2900/adapters.safetensors

# Old packaged releases
northstar-ai/releases/

# AI backup scripts
northstar-ai/scripts/*.before-*.py

# macOS
.DS_Store

# NorthStar AI training/build utilities not needed at runtime
northstar-ai/scripts/build_*.py
northstar-ai/scripts/combine_northstar_phases.py
northstar-ai/scripts/run_phase*.py

# Nested AI gitignore not needed in monorepo
northstar-ai/.gitignore

.agents/mcp_config.json
scratch/

.env.save
.expo/

# Generated voice recordings (made once, reused)
.cache/

# Landing page lives in its own repository (RoyalStar120/northstarlandingpage)
Zipsite/
