<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=0.9, viewport-fit=cover">
<meta name="theme-color" content="#FFFFFF">
<title>Resume · Northstar</title>
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="icon" href="favicon.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<script src="js/ns-boot.js"></script>
<script src="js/user-data.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link rel="stylesheet" href="css/app.css">
<style>
/* ---- Resume builder: page-only styles ---- */
.rb-segment-bar { flex-shrink: 0; padding: 0 20px 12px; background: var(--cream); position: relative; z-index: 19; }

/* Wizard step header */
.rb-step-title { font-size: clamp(21px, 6vw, 24px); line-height: 1.2; font-weight: 700; letter-spacing: -0.025em; outline: none; }
.rb-step-sub { margin-top: 8px; font-size: 15px; line-height: 1.5; font-weight: 500; color: var(--ink-2); }
.rb-field + .rb-field { margin-top: 20px; }
.rb-optional { font-weight: 500; color: var(--muted); }
.rb-field-error { margin-top: 8px; font-size: 13px; font-weight: 600; color: var(--danger); }
.ns-input.is-invalid { border-color: var(--danger); }

/* Chips: show a check mark on selected chips so the state isn't color-only */
.rb-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.rb-chips .ns-chip { white-space: normal; text-align: left; height: auto; min-height: 44px; padding-top: 8px; padding-bottom: 8px; line-height: 1.25; }
.rb-chips .ns-chip .rb-check { display: none; font-size: 18px; margin-left: -4px; }
.rb-chips .ns-chip[aria-pressed='true'] .rb-check { display: inline-block; }

/* Sticky action bar (thumb zone) — sits between the scroll area and the bottom nav */
.rb-actions {
  flex-shrink: 0; position: relative; z-index: 30;
  display: flex; gap: 12px; padding: 12px 20px;
  background: var(--cream); border-top: 1px solid var(--line);
}
.rb-actions .ns-btn--ghost { flex: 0 0 34%; }
.rb-actions .ns-btn--primary { flex: 1 1 auto; }
.app-frame.rb-has-actions .ns-fab { display: none; } /* the pinned Back/Next bar needs the room on a phone */

/* Loading */
.rb-spinner { width: 44px; height: 44px; border-radius: 50%; border: 4px solid var(--sand-deep); border-top-color: var(--ink); animation: rbSpin 0.9s linear infinite; }
@keyframes rbSpin { to { transform: rotate(360deg); } }

/* ---- The resume itself: a plain, professional document ---- */
.rb-paper {
  background: #fff; color: #111; font-size: 13px; line-height: 1.5;
  border: 1px solid #E6E6E6; border-radius: 6px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 14px 30px -20px rgba(0,0,0,0.28);
  padding: 28px 22px;
}
.rb-paper h1 { font-size: 22px; line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; color: #111; }
.rb-paper .rb-contact { margin-top: 4px; font-size: 12.5px; color: #333; display: flex; flex-wrap: wrap; column-gap: 0; }
.rb-paper .rb-contact > span:not(:empty) ~ span:not(:empty)::before { content: '|'; margin: 0 8px; color: #999; }
.rb-paper .rb-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1.5px solid #111; }
.rb-paper .rb-photo { width: 64px; height: 64px; border-radius: 6px; object-fit: cover; }
.rb-paper .rb-sec { margin-top: 18px; }
.rb-paper .rb-sec > h2 { font-size: 13px; font-weight: 700; letter-spacing: 0.01em; color: #111; padding-bottom: 4px; margin-bottom: 8px; border-bottom: 1px solid #CFCFCF; }
.rb-paper .rb-sub { font-weight: 700; color: #111; }
.rb-paper ul { list-style: disc; padding-left: 18px; }
.rb-paper li + li { margin-top: 2px; }
.rb-paper .exp-block + .exp-block { margin-top: 12px; }
.rb-paper .exp-line { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-weight: 700; }
.rb-paper .exp-duration { font-weight: 500; color: #444; white-space: nowrap; }
.rb-paper .exp-org { color: #444; font-style: italic; }
.rb-paper .exp-bullets { margin-top: 4px; }
.rb-paper .exp-org:empty, .rb-paper .exp-duration:empty { display: none; }
.rb-paper [contenteditable] { outline: none; border-radius: 3px; }
.rb-paper [contenteditable]:focus { background: #F4F4F5; box-shadow: 0 0 0 2px #D4D4D8; }
.rb-skills-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }

/* Plain text view */
.rb-plaintext { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; line-height: 1.55; min-height: 360px; padding: 16px; }

/* ---- Print: only the resume ---- */
@media print {
  @page { margin: 0.6in; }
  .no-print, .ns-header, .rb-segment-bar, .rb-actions, .ns-nav, .ns-fab, .ns-chat, .ns-chat-backdrop, .ns-sheet-wrap,
  #view-wizard-container, #view-text-container, #loading-spinner, #matched-jobs-container, #preview-empty, #guest-lock-overlay {
    display: none !important;
  }
  .ns-main { overflow: visible !important; padding: 0 !important; height: auto !important; filter: none !important; }
  #view-preview-container { display: block !important; }
  #printable-resume { border: 0 !important; box-shadow: none !important; border-radius: 0 !important; padding: 0 !important; margin: 0 !important; width: 100% !important; font-size: 11pt; }
  #printable-resume [contenteditable] { background: none !important; box-shadow: none !important; }
}
</style>
</head>
<body>

<div class="app-frame">

    <header class="ns-header no-print">
        <div class="min-w-0">
            <h1 class="ns-header__title">Resume</h1>
        </div>
        <div class="ns-header__actions">
            <button id="profile-btn" type="button" class="ns-icon-btn ns-avatar-btn" aria-label="Open settings" onclick="openSettingsModal()">S</button>
        </div>
    </header>

    <!-- View switcher -->
    <div class="rb-segment-bar no-print">
        <div class="ns-segment view-mode-tabs" role="group" aria-label="Choose a view">
            <button id="tab-wizard" type="button" onclick="switchView('wizard')" class="is-active" aria-pressed="true">Questions</button>
            <button id="tab-preview" type="button" onclick="switchView('preview')" aria-pressed="false">Resume</button>
            <button id="tab-text" type="button" onclick="switchView('text')" aria-pressed="false">Plain text</button>
        </div>
    </div>

    <main class="ns-main">

        <!-- VIEW 1: GUIDED QUESTIONS -->
        <div id="view-wizard-container" class="no-print">

            <!-- Progress -->
            <div class="pt-2" aria-live="polite">
                <div class="flex items-baseline justify-between gap-3">
                    <span id="wizard-step-label" class="text-[13px] font-bold text-ink">Step 1 of 5</span>
                    <span id="wizard-progress-percent" class="text-[13px] font-semibold text-muted">Contact</span>
                </div>
                <div class="ns-progress mt-2" role="progressbar" aria-label="Progress" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" id="wizard-progressbar">
                    <div id="wizard-progress-bar" style="width: 20%"></div>
                </div>
            </div>

            <!-- Error from the last attempt -->
            <div id="resume-error" class="hidden mt-5 rounded-card border border-danger-line bg-danger-wash p-4 text-[14px] font-semibold text-danger" role="alert"></div>

            <!-- STEP 1: CONTACT -->
            <section id="step-1" class="rb-step pt-6" aria-labelledby="step-1-title">
                <h2 id="step-1-title" class="rb-step-title" tabindex="-1">How can employers reach you?</h2>
                <p class="rb-step-sub">Only your name is required.</p>

                <div class="mt-6">
                    <div class="rb-field">
                        <label for="input-name" class="ns-label">Your name</label>
                        <input type="text" id="input-name" class="ns-input" placeholder="First and last name" autocomplete="name" required>
                        <p id="input-name-error" class="rb-field-error hidden">Please enter your name.</p>
                    </div>
                    <div class="rb-field">
                        <label for="input-phone" class="ns-label">Phone number <span class="rb-optional">(or a message phone)</span></label>
                        <input type="tel" id="input-phone" class="ns-input" placeholder="(555) 234-5678" autocomplete="tel">
                    </div>
                    <div class="rb-field">
                        <label for="input-contact" class="ns-label">Email or case worker contact</label>
                        <input type="text" id="input-contact" class="ns-input" placeholder="Email, shelter or case worker" autocomplete="email">
                        <p class="ns-hint">Helps write your resume. It isn’t printed on it.</p>
                    </div>
                    <div class="rb-field">
                        <label for="input-location" class="ns-label">City and state</label>
                        <input type="text" id="input-location" class="ns-input" placeholder="Seattle, WA" autocomplete="address-level2">
                    </div>
                    <div class="rb-field">
                        <span class="ns-label">Photo <span class="rb-optional">(optional)</span></span>
                        <div class="flex items-center gap-4">
                            <div id="photo-preview-container" class="ns-tile ns-tile--plain overflow-hidden" style="width:64px;height:64px">
                                <span id="photo-placeholder-icon" class="material-symbols-outlined">add_a_photo</span>
                                <img id="photo-preview-img" src="" alt="Your photo" class="w-full h-full object-cover hidden">
                            </div>
                            <input type="file" id="input-photo" accept="image/*" onchange="handleResumePhotoUpload(event)" class="hidden">
                            <div class="flex flex-wrap gap-2">
                                <button type="button" onclick="document.getElementById('input-photo').click()" class="ns-btn ns-btn--ghost ns-btn--sm">Choose photo</button>
                                <button type="button" id="remove-photo-btn" onclick="removeResumePhoto()" class="hidden ns-btn ns-btn--ghost ns-btn--sm">Remove</button>
                            </div>
                        </div>
                        <p class="ns-hint">Most job applications in the US don’t need a photo.</p>
                    </div>
                </div>
            </section>

            <!-- STEP 2: WORK & INFORMAL EXPERIENCE -->
            <section id="step-2" class="rb-step pt-6 hidden" aria-labelledby="step-2-title">
                <h2 id="step-2-title" class="rb-step-title" tabindex="-1">What work have you done?</h2>
                <p class="rb-step-sub">Tap all that fit. Paid jobs, day labor, volunteering and helping family all count.</p>

                <div class="rb-chips mt-6" id="experience-chips-container">
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Day Labor"><span class="material-symbols-outlined rb-check">check</span>Day labor</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Kitchen & Food Prep"><span class="material-symbols-outlined rb-check">check</span>Kitchen and food prep</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Shelter & Pantry Volunteering"><span class="material-symbols-outlined rb-check">check</span>Shelter or pantry volunteering</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Warehouse & Freight"><span class="material-symbols-outlined rb-check">check</span>Warehouse and freight</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Caregiving & Family Support"><span class="material-symbols-outlined rb-check">check</span>Caregiving</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Janitorial & Cleaning"><span class="material-symbols-outlined rb-check">check</span>Cleaning and janitorial</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Landscaping & Grounds Keeping"><span class="material-symbols-outlined rb-check">check</span>Landscaping and yard work</button>
                    <button type="button" class="chip-btn ns-chip" aria-pressed="false" data-val="Retail & Customer Service"><span class="material-symbols-outlined rb-check">check</span>Customer service</button>
                </div>

                <div class="rb-field mt-6">
                    <label for="input-informal-notes" class="ns-label">What did you do there? <span class="rb-optional">(optional)</span></label>
                    <textarea id="input-informal-notes" rows="3" class="ns-textarea" placeholder="For example: prepped meals, unloaded trucks, kept the pantry organized"></textarea>
                </div>
            </section>

            <!-- STEP 3: SKILLS & CERTIFICATIONS -->
            <section id="step-3" class="rb-step pt-6 hidden" aria-labelledby="step-3-title">
                <h2 id="step-3-title" class="rb-step-title" tabindex="-1">What are you good at?</h2>
                <p class="rb-step-sub">Tap any cards, licenses or strengths you have.</p>

                <div class="rb-chips mt-6" id="skills-chips-container">
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Food Handler Card"><span class="material-symbols-outlined rb-check">check</span>Food handler card</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Forklift Certified"><span class="material-symbols-outlined rb-check">check</span>Forklift certified</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Heavy Lifting 50+ lbs"><span class="material-symbols-outlined rb-check">check</span>Can lift 50+ lbs</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Reliable & Punctual"><span class="material-symbols-outlined rb-check">check</span>Reliable and on time</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Bilingual / Multilingual"><span class="material-symbols-outlined rb-check">check</span>Speak more than one language</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="OSHA 10 Safety"><span class="material-symbols-outlined rb-check">check</span>OSHA 10 safety</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="Pallet Jack Operator"><span class="material-symbols-outlined rb-check">check</span>Pallet jack</button>
                    <button type="button" class="skill-chip ns-chip" aria-pressed="false" data-val="First Aid & CPR"><span class="material-symbols-outlined rb-check">check</span>First aid and CPR</button>
                </div>
            </section>

            <!-- STEP 4: TARGET JOB TYPES -->
            <section id="step-4" class="rb-step pt-6 hidden" aria-labelledby="step-4-title">
                <h2 id="step-4-title" class="rb-step-title" tabindex="-1">What kind of job do you want?</h2>
                <p class="rb-step-sub">Tap one or more. Your resume will focus on these.</p>

                <div class="rb-chips mt-6" id="roles-chips-container">
                    <button type="button" class="role-chip ns-chip" aria-pressed="false" data-val="Kitchen Prep & Dishwasher"><span class="material-symbols-outlined rb-check">check</span>Kitchen staff and prep</button>
                    <button type="button" class="role-chip ns-chip" aria-pressed="false" data-val="Warehouse & Logistics Associate"><span class="material-symbols-outlined rb-check">check</span>Warehouse associate</button>
                    <button type="button" class="role-chip ns-chip" aria-pressed="false" data-val="General Laborer"><span class="material-symbols-outlined rb-check">check</span>General laborer</button>
                    <button type="button" class="role-chip ns-chip" aria-pressed="false" data-val="Sanitation & Janitorial"><span class="material-symbols-outlined rb-check">check</span>Custodial and sanitation</button>
                    <button type="button" class="role-chip ns-chip" aria-pressed="false" data-val="Retail Stocker & Cashier"><span class="material-symbols-outlined rb-check">check</span>Retail stocker or cashier</button>
                </div>
            </section>

            <!-- STEP 5: EDUCATION & CERTIFICATIONS -->
            <section id="step-5" class="rb-step pt-6 hidden" aria-labelledby="step-5-title">
                <h2 id="step-5-title" class="rb-step-title" tabindex="-1">School and training</h2>
                <p class="rb-step-sub">Optional. Put each one on its own line.</p>

                <div class="mt-6">
                    <div class="rb-field">
                        <label for="input-education" class="ns-label">Education</label>
                        <textarea id="input-education" rows="3" class="ns-textarea" placeholder="Eastlake High School, Sammamish, WA&#10;GED"></textarea>
                    </div>
                    <div class="rb-field">
                        <label for="input-custom-certifications" class="ns-label">Other certificates or training</label>
                        <textarea id="input-custom-certifications" rows="3" class="ns-textarea" placeholder="Flagger card&#10;ServSafe"></textarea>
                    </div>
                </div>
            </section>
        </div>

        <!-- LOADING -->
        <div id="loading-spinner" class="hidden flex-col items-center justify-center text-center py-20 no-print" role="status" aria-live="polite">
            <div class="rb-spinner"></div>
            <h2 class="text-[20px] font-bold mt-6">Writing your resume…</h2>
            <p class="text-[14px] font-medium text-muted mt-2 max-w-[280px]">This can take a minute or two. Please keep this page open.</p>
        </div>

        <!-- VIEW 2: RESUME PREVIEW -->
        <div id="view-preview-container" class="hidden pt-2">

            <!-- Shown until a resume has been made -->
            <div id="preview-empty" class="ns-empty hidden no-print">
                <p class="ns-empty__title">No resume yet</p>
                <p class="ns-empty__sub">Answer the questions and we’ll write it for you.</p>
                <button type="button" onclick="switchView('wizard')" class="ns-btn ns-btn--primary ns-btn--sm mt-4">Answer the questions</button>
            </div>

            <div id="preview-content">
                <p class="flex items-center gap-2 text-[13px] font-semibold text-ink-2 mb-3 no-print action-buttons-toolbar">
                    <span class="material-symbols-outlined text-[18px]">edit</span> Tap any line to change it.
                </p>

                <!-- PRINTABLE RESUME -->
                <article id="printable-resume" class="rb-paper">
                    <div class="rb-head">
                        <div class="min-w-0 flex-1">
                            <h1 id="res-name" contenteditable="true"></h1>
                            <div class="rb-contact">
                                <span id="res-phone" contenteditable="true"></span>
                                <span id="res-location" contenteditable="true"></span>
                                <span id="res-contact" contenteditable="true"></span>
                            </div>
                        </div>
                        <div id="res-photo-header-wrapper" class="hidden flex-shrink-0">
                            <img id="res-photo-header-img" src="" alt="" class="rb-photo">
                        </div>
                    </div>

                    <section class="rb-sec">
                        <h2>Summary</h2>
                        <p id="res-summary" contenteditable="true"></p>
                    </section>

                    <section class="rb-sec">
                        <h2>Skills</h2>
                        <div class="rb-skills-grid">
                            <div>
                                <p class="rb-sub">Certifications and licenses</p>
                                <ul id="res-skills-certs" contenteditable="true"></ul>
                            </div>
                            <div>
                                <p class="rb-sub">Practical skills</p>
                                <ul id="res-skills-practical" contenteditable="true"></ul>
                            </div>
                        </div>
                    </section>

                    <section class="rb-sec">
                        <h2>Experience</h2>
                        <div id="res-experience-list"></div>
                    </section>

                    <section class="rb-sec">
                        <h2>Education and training</h2>
                        <ul id="res-education" contenteditable="true"></ul>
                    </section>
                </article>

                <div class="mt-6 flex flex-col gap-3 no-print">
                    <button type="button" onclick="exportToPDF()" class="ns-btn ns-btn--primary">
                        <span class="material-symbols-outlined">print</span> Print or save as PDF
                    </button>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" onclick="copyCleanText()" class="ns-btn ns-btn--ghost">
                            <span class="material-symbols-outlined">content_copy</span> <span class="rb-copy-label">Copy text</span>
                        </button>
                        <button type="button" onclick="switchView('wizard')" class="ns-btn ns-btn--ghost">
                            <span class="material-symbols-outlined">tune</span> Edit answers
                        </button>
                    </div>
                </div>

                <!-- Jobs that match this resume (filled by matchAndRenderJobs in js/northstar.js) -->
                <div id="matched-jobs-container" class="no-print"></div>
            </div>
        </div>

        <!-- VIEW 3: PLAIN TEXT -->
        <div id="view-text-container" class="hidden pt-2 no-print">
            <div id="text-empty" class="ns-empty hidden">
                <p class="ns-empty__title">No resume yet</p>
                <p class="ns-empty__sub">Once your resume is ready, the plain text shows up here.</p>
                <button type="button" onclick="switchView('wizard')" class="ns-btn ns-btn--primary ns-btn--sm mt-4">Answer the questions</button>
            </div>
            <div id="text-content">
                <p class="text-[14px] font-medium text-ink-2">Paste this into online job applications or emails. It has no formatting, so it works everywhere.</p>
                <label for="ats-plain-text-area" class="sr-only">Resume as plain text</label>
                <textarea id="ats-plain-text-area" rows="18" readonly class="ns-textarea rb-plaintext mt-4"></textarea>
                <button type="button" onclick="copyCleanText()" class="ns-btn ns-btn--primary mt-4">
                    <span class="material-symbols-outlined">content_copy</span> <span class="rb-copy-label">Copy all text</span>
                </button>
            </div>
        </div>

    </main>

    <!-- Wizard actions, in the thumb zone -->
    <div id="wizard-actions" class="rb-actions no-print">
        <button type="button" id="btn-wizard-back" onclick="rbBack()" class="ns-btn ns-btn--ghost hidden">Back</button>
        <button type="button" id="btn-wizard-next" onclick="rbNext()" class="ns-btn ns-btn--primary">Next</button>
        <button type="button" id="btn-generate-resume" onclick="generateResume()" class="ns-btn ns-btn--primary hidden">Create my resume</button>
    </div>

    <nav class="bottom-nav ns-nav" aria-label="Main"></nav>

</div>

<script src="js/northstar.js"></script>
    <script src="js/jobs.js"></script>
<script>
// ============================================================
// RESUME BUILDER
// Single canonical source of truth for generated resume state.
// ============================================================

// These two variables are the ONLY authoritative resume state.
// They persist across SPA re-evals because they are on window.
// Never read from localStorage or old DOM after generation.
window.currentGeneratedResumeText = window.currentGeneratedResumeText || '';
window.currentGeneratedResumeData = window.currentGeneratedResumeData || null;

// Profile photo state (page-local; reset is fine on nav)
let uploadedResumePhotoBase64 = '';

// ============================================================
// Photo Upload
// ============================================================
function handleResumePhotoUpload(event) {
  const file = event.target.files && event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    uploadedResumePhotoBase64 = e.target.result;

    const previewImg = document.getElementById('photo-preview-img');
    const placeholderIcon = document.getElementById('photo-placeholder-icon');
    const removeBtn = document.getElementById('remove-photo-btn');

    if (previewImg) { previewImg.src = uploadedResumePhotoBase64; previewImg.classList.remove('hidden'); }
    if (placeholderIcon) placeholderIcon.classList.add('hidden');
    if (removeBtn) removeBtn.classList.remove('hidden');

    const headerImg = document.getElementById('res-photo-header-img');
    const headerWrapper = document.getElementById('res-photo-header-wrapper');
    if (headerImg && headerWrapper) {
      headerImg.src = uploadedResumePhotoBase64;
      headerWrapper.classList.remove('hidden');
    }

    if (window.showNotification) showNotification('Profile photo attached to resume!', 'success');
  };
  reader.readAsDataURL(file);
}

function removeResumePhoto() {
  uploadedResumePhotoBase64 = '';
  const previewImg = document.getElementById('photo-preview-img');
  const placeholderIcon = document.getElementById('photo-placeholder-icon');
  const removeBtn = document.getElementById('remove-photo-btn');
  const fileInput = document.getElementById('input-photo');

  if (fileInput) fileInput.value = '';
