  let text = `${name.toUpperCase()}\n`;
  text += `${phone} | ${location}\n\n`;
  text += `========================================\nPROFESSIONAL SUMMARY\n========================================\n${summary}\n\n`;
  text += `========================================\nCORE COMPETENCIES & SKILLS\n========================================\n`;
  document.querySelectorAll('#res-skills-certs li, #res-skills-practical li').forEach(li => { text += `• ${li.innerText}\n`; });
  text += '\n========================================\nWORK & PRACTICAL EXPERIENCE\n========================================\n';
  document.querySelectorAll('.exp-block').forEach(block => {
    const role = block.querySelector('.exp-role')?.innerText || '';
