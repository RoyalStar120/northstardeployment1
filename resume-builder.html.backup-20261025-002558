  document.querySelectorAll('#res-education li').forEach(li => { text += `• ${li.innerText}\n`; });
  textarea.value = text;
}

// ============================================================
// Copy & Export
// ============================================================
// navigator.clipboard only exists on https/localhost; elsewhere (http on the phone) fall back to a selection copy
function rbWriteClipboard(text, sourceEl) {
  const legacy = () => {
    try {
      let el = sourceEl;
      let temp = null;
      if (!el) {
        temp = document.createElement('textarea');
        temp.value = text;
        temp.setAttribute('readonly', '');
        temp.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
        document.body.appendChild(temp);
        el = temp;
      }
      el.focus();
      el.select();
      if (el.setSelectionRange) el.setSelectionRange(0, el.value.length);
      const ok = document.execCommand('copy');
      if (temp) temp.remove();
      return ok;
    } catch (e) { return false; }
  };
  if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
    return navigator.clipboard.writeText(text).then(() => true, () => legacy());
  }
  return Promise.resolve(legacy());
}

function copyCleanText() {
  // Generate the latest text first, then copy
  generatePlainText();
  const textarea = document.getElementById('ats-plain-text-area');
  if (!textarea || !textarea.value) {
    // Fallback: copy directly from currentGeneratedResumeText
    if (window.currentGeneratedResumeText) {
      rbWriteClipboard(window.currentGeneratedResumeText).then(ok => {
        if (ok) { rbCopied(); if (window.showNotification) showNotification('Resume text copied to clipboard!', 'success'); }
        else if (window.showNotification) showNotification('Copy failed. Please copy manually.', 'error');
      });
      return;
    }
    if (window.showNotification) showNotification('No resume to copy yet. Generate a resume first.', 'info');
    return;
  }
  rbWriteClipboard(textarea.value, textarea).then(ok => {
    if (ok) { rbCopied(); if (window.showNotification) showNotification('Resume text copied to clipboard!', 'success'); }
    else if (window.showNotification) showNotification('Copy failed. Please copy manually.', 'error');
  });
}

// Real feedback on the copy buttons (only after the clipboard write succeeded)
function rbCopied() {
  document.querySelectorAll('.rb-copy-label').forEach(el => {
    if (!el.dataset.label) el.dataset.label = el.textContent;
    el.textContent = 'Copied';
    clearTimeout(el._rbT);
    el._rbT = setTimeout(() => { el.textContent = el.dataset.label; }, 2000);
  });
}

