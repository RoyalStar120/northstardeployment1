// ============================================================
// View Switching — does NOT touch resume data, only visibility
// ============================================================
function switchView(viewName) {
  const wizardContainer = document.getElementById('view-wizard-container');
  const previewContainer = document.getElementById('view-preview-container');
  const textContainer = document.getElementById('view-text-container');
  const tabWizard = document.getElementById('tab-wizard');
  const tabPreview = document.getElementById('tab-preview');
  const tabText = document.getElementById('tab-text');

  if (!wizardContainer || !previewContainer || !textContainer) return;
  // While the resume is being written, stay on the loading screen
  if (window.rbGenerating) return;

  const setTab = (t, on) => {
    if (!t) return;
    t.classList.toggle('is-active', on);
    t.setAttribute('aria-pressed', on ? 'true' : 'false');
  };
  [tabWizard, tabPreview, tabText].forEach(t => setTab(t, false));
  wizardContainer.classList.add('hidden');
  previewContainer.classList.add('hidden');
  textContainer.classList.add('hidden');

  const hasResume = !!(window.currentGeneratedResumeData || window.currentGeneratedResumeText);
  const main = document.querySelector('main');

  if (viewName === 'wizard') {
    wizardContainer.classList.remove('hidden');
    setTab(tabWizard, true);
    rbSetActionsVisible(true);
  } else if (viewName === 'preview') {
    previewContainer.classList.remove('hidden');
    setTab(tabPreview, true);
    rbSetActionsVisible(false);
    const empty = document.getElementById('preview-empty');
    const content = document.getElementById('preview-content');
    if (empty) empty.classList.toggle('hidden', hasResume);
    if (content) content.classList.toggle('hidden', !hasResume);
    // Scroll preview to top
    if (main) main.scrollTop = 0;
  } else if (viewName === 'text') {
    textContainer.classList.remove('hidden');
    setTab(tabText, true);
    rbSetActionsVisible(false);
    const empty = document.getElementById('text-empty');
    const content = document.getElementById('text-content');
    if (empty) empty.classList.toggle('hidden', hasResume);
    if (content) content.classList.toggle('hidden', !hasResume);
    if (main) main.scrollTop = 0;
    // Always regenerate ATS text from canonical state when tab opens
    generatePlainText();
  }
}

// ============================================================
// Wizard steps — one question group per screen
// ============================================================
const RB_STEP_NAMES = ['Contact', 'Work', 'Skills', 'Job types', 'School'];
const RB_TOTAL_STEPS = RB_STEP_NAMES.length;
let rbCurrentStep = 1;

function rbSetActionsVisible(show) {
  // Guests see the sign-in lock over the questions, so keep the step buttons out of the way
  try { const ses = typeof getSession === 'function' ? getSession() : null; if (ses && ses.isGuest) show = false; } catch (e) {}
  const bar = document.getElementById('wizard-actions');
  if (bar) bar.classList.toggle('hidden', !show);
  const frame = document.querySelector('.app-frame');
  if (frame) frame.classList.toggle('rb-has-actions', !!show);
}

function rbShowError(msg) {
  const box = document.getElementById('resume-error');
  if (!box) return;
  box.textContent = msg || '';
  box.classList.toggle('hidden', !msg);
}

function rbGoToStep(n, focus = true) {
  rbCurrentStep = Math.min(Math.max(1, n), RB_TOTAL_STEPS);
  for (let i = 1; i <= RB_TOTAL_STEPS; i++) {
    const s = document.getElementById('step-' + i);
    if (s) s.classList.toggle('hidden', i !== rbCurrentStep);
  }
  const label = document.getElementById('wizard-step-label');
  const name = document.getElementById('wizard-progress-percent');
  const bar = document.getElementById('wizard-progress-bar');
  const pb = document.getElementById('wizard-progressbar');
  if (label) label.textContent = `Step ${rbCurrentStep} of ${RB_TOTAL_STEPS}`;
  if (name) name.textContent = RB_STEP_NAMES[rbCurrentStep - 1];
  if (bar) bar.style.width = `${(rbCurrentStep / RB_TOTAL_STEPS) * 100}%`;
  if (pb) pb.setAttribute('aria-valuenow', String(rbCurrentStep));

  const isLast = rbCurrentStep === RB_TOTAL_STEPS;
  document.getElementById('btn-wizard-back')?.classList.toggle('hidden', rbCurrentStep === 1);
  document.getElementById('btn-wizard-next')?.classList.toggle('hidden', isLast);
  document.getElementById('btn-generate-resume')?.classList.toggle('hidden', !isLast);

  const main = document.querySelector('main');
  if (main) main.scrollTop = 0;
  if (focus) document.getElementById(`step-${rbCurrentStep}-title`)?.focus({ preventScroll: true });
}

function rbValidateName() {
  const input = document.getElementById('input-name');
  const err = document.getElementById('input-name-error');
  const ok = !!(input && input.value.trim());
  if (input) { input.classList.toggle('is-invalid', !ok); input.setAttribute('aria-invalid', ok ? 'false' : 'true'); }
  if (err) err.classList.toggle('hidden', ok);
  return ok;
}

function rbNext() {
  if (rbCurrentStep === 1 && !rbValidateName()) {
    document.getElementById('input-name')?.focus();
    return;
  }
  rbGoToStep(rbCurrentStep + 1);
}

function rbBack() {
  rbGoToStep(rbCurrentStep - 1);
}

// ============================================================
// Resume Parser — reads result.resume text as source of truth
// ============================================================
function parseValidatedResume(resumeText, fallbackData = {}) {
  console.log('[NorthStar] RAW resume entering parser:', resumeText);

  if (!resumeText || typeof resumeText !== 'string') {
    throw new Error('NorthStar AI returned empty resume text.');
  }

  let cleanText = resumeText
    .replace(/```[a-zA-Z]*\s*/g, '')
    .replace(/```/g, '')
    .replace(/<think>[\s\S]*?<\/think>/gi, '')
    .trim();

  const rawLines = cleanText
    .split(/\r?\n/)
    .map(line => line.trim());

  const sections = {
    HEADER: [],
    SUMMARY: [],
    CERTIFICATIONS: [],
    EDUCATION: [],
    EXPERIENCE: [],
    SKILLS: []
  };

  let section = 'HEADER';

  function normalizeHeading(line) {
    return line
      .replace(/^#+\s*/, '')
      .replace(/\*\*/g, '')
      .replace(/__+/g, '')
      .replace(/:$/, '')
      .trim()
      .toUpperCase();
  }

  for (const originalLine of rawLines) {
    if (!originalLine) continue;

    const line = originalLine
      .replace(/^#+\s*/, '')
      .replace(/\*\*/g, '')
      .trim();

    const heading = normalizeHeading(line);

    if (
      heading === 'SUMMARY' ||
      heading === 'PROFESSIONAL SUMMARY'
    ) {
      section = 'SUMMARY';
      continue;
    }

    if (
      heading === 'CERTIFICATIONS' ||
      heading === 'CERTIFICATION' ||
      heading === 'CERTIFICATIONS & LICENSES' ||
      heading === 'CERTIFICATIONS AND LICENSES'
    ) {
      section = 'CERTIFICATIONS';
      continue;
    }

    if (
      heading === 'EDUCATION' ||
      heading === 'CERTIFICATIONS & EDUCATION' ||
      heading === 'EDUCATION & CERTIFICATIONS'
    ) {
      section = 'EDUCATION';
      continue;
    }

    if (
      heading === 'RELEVANT EXPERIENCE' ||
      heading === 'EXPERIENCE' ||
      heading === 'WORK EXPERIENCE' ||
      heading === 'WORK & PRACTICAL EXPERIENCE' ||
      heading === 'PRACTICAL EXPERIENCE'
    ) {
      section = 'EXPERIENCE';
      continue;
    }

    if (
      heading === 'SKILLS' ||
      heading === 'CORE SKILLS' ||
      heading === 'CORE COMPETENCIES' ||
      heading === 'CORE COMPETENCIES & SKILLS' ||
      heading === 'PRACTICAL & SOFT SKILLS'
    ) {
      section = 'SKILLS';
      continue;
    }

    sections[section].push(line);
  }

  // ----------------------------------------------------------
  // CONTACT INFORMATION
  // The current Guided Wizard values are confirmed user facts.
  // They take priority over parser guesses.
  // ----------------------------------------------------------

  let parsedName = fallbackData.name || '';
  let parsedPhone = fallbackData.phone || '';
  let parsedLocation = fallbackData.location || '';

  const header = sections.HEADER;

  if (!parsedName && header.length > 0) {
    parsedName = header[0];
  }

  if ((!parsedPhone || !parsedLocation) && header.length > 1) {
    const contactLine = header.find(line => line.includes('|'));

    if (contactLine) {
      const parts = contactLine
        .split('|')
        .map(part => part.trim())
        .filter(Boolean);

      for (const part of parts) {
        const looksLikePhone =
          /\(?\d{3}\)?[\s.-]*\d{3}[\s.-]*\d{4}/.test(part);

        if (looksLikePhone && !parsedPhone) {
          parsedPhone = part;
        } else if (!looksLikePhone && !parsedLocation) {
          parsedLocation = part;
        } else if (/\d{3}/.test(part) && !parsedPhone) {
          parsedPhone = part;
        } else if (!parsedLocation) {
          parsedLocation = part;
        }
      }
    }
  }

  const summary = sections.SUMMARY.join(' ').trim();
  
  const practicalSkills = [];
  for (const line of sections.SKILLS) {
    const items = line.replace(/^[-•*]\s*/, '').split('|').map(item => item.trim()).filter(Boolean);
    practicalSkills.push(...items);
  }

  const certifications = [];
  for (const line of sections.CERTIFICATIONS) {
    const items = line.replace(/^[-•*]\s*/, '').split('|').map(item => item.trim()).filter(Boolean);
    certifications.push(...items);
  }
  
  const certifications_education = [];
  for (const line of sections.EDUCATION) {
    const items = line.replace(/^[-•*]\s*/, '').split('|').map(item => item.trim()).filter(Boolean);
    certifications_education.push(...items);
  }

  const experience = [];
  let currentExperience = null;

  for (const line of sections.EXPERIENCE) {
    const isBullet = /^[-•*]\s*/.test(line);

    if (isBullet) {
      const bulletText = line.replace(/^[-•*]\s*/, '').trim();
      if (!currentExperience) {
        currentExperience = { role: 'Relevant Experience', duration: '', organization: '', bullets: [] };
        experience.push(currentExperience);
      }
      currentExperience.bullets.push(bulletText);
      continue;
    }

    currentExperience = { role: line, duration: '', organization: '', bullets: [] };
    experience.push(currentExperience);
  }

  if (certifications.length === 0 && Array.isArray(fallbackData.certifications)) {
    certifications.push(...fallbackData.certifications);
  }

  if (practicalSkills.length === 0 && Array.isArray(fallbackData.skills)) {
    practicalSkills.push(...fallbackData.skills);
  }
  
  if (certifications_education.length === 0 && Array.isArray(fallbackData.education)) {
    certifications_education.push(...fallbackData.education);
  }

  const parsed = {
    contact_info: {
      name: parsedName,
      phone: parsedPhone,
      location: parsedLocation,
      contact: ''
    },
    summary,
    skills: {
      certifications,
      practical_skills: practicalSkills,
      core_strengths: []
    },
    experience,
    certifications_education
  };

  console.log(
    '[NorthStar] FINAL PARSED RESUME:',
    JSON.stringify(parsed, null, 2)
  );

  return parsed;
}

