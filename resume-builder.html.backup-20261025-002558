// ============================================================
// Main Generation Function
// ============================================================
async function generateResume() {
  const nameInput = document.getElementById('input-name');
  const phoneInput = document.getElementById('input-phone');
  const contactInput = document.getElementById('input-contact');
  const locationInput = document.getElementById('input-location');
  const notesInput = document.getElementById('input-informal-notes');
  const eduInput = document.getElementById('input-education');
  const customCertsInput = document.getElementById('input-custom-certifications');
  const generateBtn = document.getElementById('btn-generate-resume');

  const name = (nameInput && nameInput.value) ? nameInput.value.trim() : '';
  const phone = (phoneInput && phoneInput.value) ? phoneInput.value.trim() : '';
  const contactInfo = (contactInput && contactInput.value) ? contactInput.value.trim() : '';
  const location = (locationInput && locationInput.value) ? locationInput.value.trim() : '';
  const informalNotes = (notesInput && notesInput.value) ? notesInput.value.trim() : '';
  
  const rawEdu = (eduInput && eduInput.value) ? eduInput.value.trim() : '';
  const eduArr = rawEdu ? rawEdu.split('\n').map(s => s.trim()).filter(Boolean) : [];

  const rawCerts = (customCertsInput && customCertsInput.value) ? customCertsInput.value.trim() : '';
  const customCertsArr = rawCerts ? rawCerts.split('\n').map(s => s.trim()).filter(Boolean) : [];

  if (!name) {
    rbGoToStep(1, false);
    rbValidateName();
    if (nameInput) nameInput.focus();
    if (window.showNotification) showNotification('Please enter your name.', 'error');
    return;
  }
  rbShowError('');

  const experienceTypes = getSelectedChips('.chip-btn');
  const skillsCertifications = getSelectedChips('.skill-chip');
  const targetRoles = getSelectedChips('.role-chip');

  const certificationNames = ['Food Handler Card', 'Forklift Certified', 'OSHA 10 Safety', 'First Aid & CPR'];
  const certifications = [...skillsCertifications.filter(i => certificationNames.includes(i)), ...customCertsArr];
  const practicalSkills = skillsCertifications.filter(i => !certificationNames.includes(i));

  const confirmedNumbers = [];
  if (skillsCertifications.includes('Heavy Lifting 50+ lbs')) confirmedNumbers.push('50+');
  const contactNumbers = phone.match(/\d+/g) || [];

  const confirmed = {
    name, phone, location,
    alternate_contact: contactInfo,
    experience_categories: experienceTypes,
    tasks: informalNotes ? [informalNotes] : [],
    employers: [],
    possible_employers: contactInfo ? [contactInfo] : [],
    job_titles: [], unconfirmed_job_titles: [],
    dates: [], durations: [],
    confirmed_numbers: confirmedNumbers,
    contact_numbers: contactNumbers,
    certifications, 
    education: eduArr,
    languages: [],
    skills: practicalSkills,
    target_jobs: targetRoles
  };

  console.log('[NorthStar] WIZARD DATA sent to API:', JSON.stringify(confirmed, null, 2));

  // Runs as a background job on the server so leaving this page doesn't stop it
  rbShowGenerating();

  try {
    if (window.nsResumeJob) {
      await window.nsResumeJob.start(confirmed);
      rbWatchResumeJob();
      return;
    }
    // Fallback (shared script missing): wait on the request directly
    const response = await fetch('/api/generate-resume', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(confirmed)
    });
    const result = await response.json();
    if (!response.ok || !result.success || !result.resume) {
      throw new Error(result.error || 'Generation failed — no resume returned from API');
    }
    rbApplyResumeResult(result, confirmed);
  } catch (err) {
    rbApplyResumeFailure(err);
  }
}

// --- Loading state while the resume is being written ---
function rbShowGenerating() {
  const wizardContainer = document.getElementById('view-wizard-container');
  const loadingSpinner = document.getElementById('loading-spinner');
  const generateBtn = document.getElementById('btn-generate-resume');
  if (wizardContainer) wizardContainer.classList.add('hidden');
  if (loadingSpinner) { loadingSpinner.classList.remove('hidden'); loadingSpinner.classList.add('flex'); }
  if (generateBtn) generateBtn.disabled = true;
  rbSetActionsVisible(false);
  window.rbGenerating = true;
  const mainEl = document.querySelector('main');
  if (mainEl) mainEl.scrollTop = 0;
}

function rbStopGenerating() {
  const loadingSpinner = document.getElementById('loading-spinner');
  const generateBtn = document.getElementById('btn-generate-resume');
  if (loadingSpinner) { loadingSpinner.classList.add('hidden'); loadingSpinner.classList.remove('flex'); }
  if (generateBtn) generateBtn.disabled = false;
  window.rbGenerating = false;
}

// Wait for the background job (started here or before leaving the page) to finish
let rbJobListener = null;
function rbWatchResumeJob() {
  if (!window.nsResumeJob) return;
  if (rbJobListener) window.removeEventListener('ns:resume-job', rbJobListener);
  rbJobListener = (e) => rbHandleFinishedJob(e.detail);
  window.addEventListener('ns:resume-job', rbJobListener);
  window.nsResumeJob.watch();
}

function rbHandleFinishedJob(job) {
  if (!job || job.status === 'running') return;
  if (rbJobListener) { window.removeEventListener('ns:resume-job', rbJobListener); rbJobListener = null; }
  window.nsResumeJob.clear();
  document.getElementById('ns-resume-ready-pill')?.remove();
  const result = job.result || {};
  if (job.status === 'done' && result.success && result.resume) {
    try {
      rbApplyResumeResult(result, job.confirmed || {});
    } catch (err) {
      rbApplyResumeFailure(err);
    }
  } else {
    rbApplyResumeFailure(new Error(result.error || 'Generation failed — no resume returned from API'));
  }
}

function rbApplyResumeResult(result, confirmed) {
  console.log('[NorthStar] RAW NEW RESUME:\n', result.resume);
  console.log('[NorthStar] Validation:', result.validation);
  console.log('[NorthStar] Repairs:', result.repairs);

  // ----------------------------------------------------------------
  // CANONICAL STATE UPDATE — this is the single source of truth
  // ----------------------------------------------------------------
  const parsedResume = parseValidatedResume(result.resume, confirmed);

  if (!parsedResume.summary &&
      !parsedResume.experience.length &&
      !parsedResume.skills.certifications.length &&
      !parsedResume.skills.practical_skills.length) {
    throw new Error('Generated resume could not be parsed.');
  }

  window.currentGeneratedResumeText = result.resume;
  window.currentGeneratedResumeData = parsedResume;

  // Completely replace the preview DOM
  populateResumeData(window.currentGeneratedResumeData);

  // Persist the new resume (for logged-in users; no-op for guests)
  if (typeof window.saveResumeData === 'function') {
    window.saveResumeData(window.currentGeneratedResumeData);
  }

  // Also persist to a direct localStorage key for cross-page resilience
  try {
    localStorage.setItem('northstar_latest_resume_text', window.currentGeneratedResumeText);
    localStorage.setItem('northstar_latest_resume_data', JSON.stringify(window.currentGeneratedResumeData));
  } catch(e) { /* storage quota */ }

  // --- Stop loading state ---
  rbStopGenerating();

  // ATS uses the exact latest validated NorthStar AI output.
  const atsArea = document.getElementById('ats-plain-text-area');
  if (atsArea) {
    atsArea.value = window.currentGeneratedResumeText;
  }

  // Switch only AFTER the newest resume has been parsed and rendered.
  switchView('preview');

  // Keep ATS synchronized with canonical state.
  generatePlainText();

  if (window.showNotification) showNotification('Your resume is ready.', 'success');
}

function rbApplyResumeFailure(err) {
  console.error('[NorthStar] Generation error:', err);

  // --- Stop loading, return to wizard ---
  const wizardContainer = document.getElementById('view-wizard-container');
  rbStopGenerating();
  if (wizardContainer) wizardContainer.classList.remove('hidden');
  rbSetActionsVisible(true);

  const errorMsg = (err && err.message) || 'Resume generation failed.';
  console.error('[NorthStar] FINAL GENERATION FAILURE:', errorMsg);
  // Show a plain message on the page (showNotification is intentionally silent)
  rbShowError(/too long/i.test(errorMsg)
    ? 'This took too long. Your answers are still here, so please try again.'
    : 'We couldn’t write your resume just now. Your answers are still here, so please try again in a minute.');
  const mainErr = document.querySelector('main');
  if (mainErr) mainErr.scrollTop = 0;
  if (window.showNotification) showNotification(`Error: ${errorMsg}`, 'error');
}

// Put the person's answers back in the form (after coming back mid-generation)
function rbRestoreAnswers(confirmed) {
  if (!confirmed) return;
  const set = (id, v) => { const el = document.getElementById(id); if (el && v && !el.value) el.value = v; };
  set('input-name', confirmed.name);
  set('input-phone', confirmed.phone);
  set('input-location', confirmed.location);
  set('input-contact', confirmed.alternate_contact);
  set('input-informal-notes', (confirmed.tasks || []).join('\n'));
  set('input-education', (confirmed.education || []).join('\n'));

  // Chips: what was picked (skills + certificates both live on the skill chips)
  const pick = (selector, values) => {
    const wanted = new Set((values || []).map(v => String(v).trim().toLowerCase()));
    if (!wanted.size) return;
    document.querySelectorAll(selector).forEach(btn => {
      const val = String(btn.dataset.val || btn.innerText || '').trim().toLowerCase();
      if (wanted.has(val)) { btn.classList.add('active-chip'); btn.setAttribute('aria-pressed', 'true'); }
    });
  };
  const certs = Array.isArray(confirmed.certifications) ? confirmed.certifications : [];
  pick('.chip-btn', confirmed.experience_categories);
  pick('.skill-chip', [...(confirmed.skills || []), ...certs, ...((confirmed.confirmed_numbers || []).includes('50+') ? ['Heavy Lifting 50+ lbs'] : [])]);
  pick('.role-chip', confirmed.target_jobs);

  // Typed certificates are the ones that aren't a chip
  const chipCerts = new Set(Array.from(document.querySelectorAll('.skill-chip')).map(b => String(b.dataset.val || '').trim().toLowerCase()));
  const custom = certs.filter(c => !chipCerts.has(String(c).trim().toLowerCase()));
  set('input-custom-certifications', custom.join('\n'));
}

// ============================================================
// SPA Re-init: Restore latest generated resume if it exists
// This runs every time the SPA router evals this script after
// swapping the app-frame innerHTML with fresh static HTML.
// ============================================================
function resumeBuilderInit() {
  initChipToggles();
  rbGoToStep(1, false);
  rbSetActionsVisible(true);

  // Start the name field with the signed-in person's name (they can change it)
  try {
    const nameInput = document.getElementById('input-name');
    const session = typeof getSession === 'function' ? getSession() : null;
    const fullName = session && !session.isGuest ? (session.full_name || '') : '';
    if (nameInput && !nameInput.value && fullName) nameInput.value = fullName;
  } catch (e) { /* no session */ }

  // Enter on a text field moves to the next question
  document.querySelectorAll('#view-wizard-container input.ns-input').forEach(inp => {
    if (inp.dataset.rbEnter) return;
    inp.dataset.rbEnter = '1';
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); rbNext(); }
    });
  });
  document.getElementById('input-name')?.addEventListener('input', () => {
    if (document.getElementById('input-name').value.trim()) rbValidateName();
  });

  // If a resume was generated in this browser session, restore it.
  // This prevents the SPA router's innerHTML swap from reverting to
  // the static sample defaults.
  let text = window.currentGeneratedResumeText;
  let data = window.currentGeneratedResumeData;

  // If window state was cleared (e.g. hard reload), try localStorage fallback
  if (!text) {
    try {
      text = localStorage.getItem('northstar_latest_resume_text') || '';
      const raw = localStorage.getItem('northstar_latest_resume_data');
      data = raw ? JSON.parse(raw) : null;
    } catch(e) { text = ''; data = null; }
  }

  if (text && data) {
    // Re-hydrate canonical state
    window.currentGeneratedResumeText = text;
    window.currentGeneratedResumeData = data;
    // Restore the preview from saved state (overwrites static HTML defaults)
    populateResumeData(data);
    console.log('[NorthStar] Restored previous generated resume on SPA init.');
  }

  // A resume started before leaving this page: keep waiting for it, or show it if it finished
  const pendingJob = window.nsResumeJob ? window.nsResumeJob.get() : null;
  if (pendingJob) {
    rbRestoreAnswers(pendingJob.confirmed);
    if (pendingJob.status === 'running') {
      rbShowGenerating();
      rbWatchResumeJob();
    } else {
      rbHandleFinishedJob(pendingJob);
    }
  }
}

// ============================================================
// Expose all functions globally so SPA router eval + inline
// onclick handlers can always find them
// ============================================================
window.generateResume = generateResume;
window.switchView = switchView;
window.copyCleanText = copyCleanText;
window.exportToPDF = exportToPDF;
window.initChipToggles = initChipToggles;
window.populateResumeData = populateResumeData;
window.parseValidatedResume = parseValidatedResume;
window.handleResumePhotoUpload = handleResumePhotoUpload;
window.removeResumePhoto = removeResumePhoto;
window.rbNext = rbNext;
window.rbBack = rbBack;
window.rbGoToStep = rbGoToStep;

// Run init (works both on first page load and after SPA eval)
resumeBuilderInit();
</script>
