function populateResumeData(data) {
  if (!data) { console.error('[NorthStar] populateResumeData: no data'); return; }

  const c = data.contact_info || {};

  // --- Contact Header ---
  const nameEl = document.getElementById('res-name');
  const phoneEl = document.getElementById('res-phone');
  const locationEl = document.getElementById('res-location');
  const contactEl = document.getElementById('res-contact');

  if (nameEl) nameEl.innerText = c.name || '';
  if (phoneEl) phoneEl.innerText = c.phone || '';
  if (locationEl) locationEl.innerText = c.location || '';
  if (contactEl) contactEl.innerText = '';  // Privacy: never display shelter contact

  // --- Summary ---
  const summaryEl = document.getElementById('res-summary');
  if (summaryEl) summaryEl.innerText = data.summary || '';

  // --- Skills & Certifications (always overwrite innerHTML) ---
  const certsList = document.getElementById('res-skills-certs');
  const practicalList = document.getElementById('res-skills-practical');

  const certs = (data.skills && data.skills.certifications) ? data.skills.certifications : [];
  const practical = [
    ...((data.skills && data.skills.practical_skills) ? data.skills.practical_skills : []),
    ...((data.skills && data.skills.core_strengths) ? data.skills.core_strengths : [])
  ];

  const esc = (v) => (typeof window.nsEscape === 'function' ? window.nsEscape(v == null ? '' : String(v)) : String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch])));

  if (certsList) certsList.innerHTML = certs.map(i => `<li contenteditable="true">${esc(i)}</li>`).join('');
  if (practicalList) practicalList.innerHTML = practical.map(i => `<li contenteditable="true">${esc(i)}</li>`).join('');

  // --- Experience (always overwrite innerHTML, even if empty) ---
  const expContainer = document.getElementById('res-experience-list');
  if (expContainer) {
    const expData = data.experience || [];
    expContainer.innerHTML = expData.map(exp => `
      <div class="exp-block">
        <div class="exp-line">
          <span contenteditable="true" class="exp-role">${esc(exp.role || '')}</span>
          <span contenteditable="true" class="exp-duration">${esc(exp.duration || '')}</span>
        </div>
        <div contenteditable="true" class="exp-org">${esc(exp.organization || '')}</div>
        <ul class="exp-bullets">
          ${(exp.bullets || []).map(b => `<li contenteditable="true">${esc(b)}</li>`).join('')}
        </ul>
      </div>
    `).join('');
  }

  // --- Education / Certifications (always overwrite innerHTML) ---
  const eduList = document.getElementById('res-education');
  if (eduList) {
    const eduData = data.certifications_education || [];
    eduList.innerHTML = eduData.map(e => `<li contenteditable="true">${esc(e)}</li>`).join('');
  }

  console.log('[NorthStar] populateResumeData complete. Name =', c.name, 'Phone =', c.phone);
}

